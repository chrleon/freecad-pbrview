<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>PbrView</name>
  <description>
    En levende render av FreeCAD-dokumentet i et eget vindu. Principled-
    aktig BSDF, miljoebelysning, skyggekart og filmisk tonemapping, tegnet
    med OpenGL 4.1 inne i FreeCADs prosess. Navigasjonen styrer FreeCADs
    eget kamera, saa de to visningene foelger hverandre.
  </description>
  <version>0.1.0</version>
  <date>2026-09-18</date>

  <maintainer email="christian.christensen@scaleaq.com">Christian Leon</maintainer>
  <author>Christian Leon</author>
  <license file="LICENSE">MIT</license>

  <url type="repository" branch="main">https://github.com/chrleon/freecad-pbrview</url>
  <url type="readme">https://github.com/chrleon/freecad-pbrview/blob/main/README.md</url>
  <url type="bugtracker">https://github.com/chrleon/freecad-pbrview/issues</url>

  <icon>PbrView.svg</icon>

  <content>
    <macro>
      <name>PbrView</name>
      <description>Levende PBR-render av dokumentet</description>
      <version>0.1.0</version>
      <icon>PbrView.svg</icon>
      <subdirectory>./</subdirectory>
      <files>
        <file>PbrView.FCMacro</file>
        <file>PbrView.svg</file>
      </files>
      <freecadmin>1.0</freecadmin>
    </macro>
  </content>
</package>
